{
  "name": "@marko/volar-language-server",
  "version": "2.1.0",
  "description": "Marko Language Server",
  "keywords": [
    "autocomplete",
    "intellisense",
    "language",
    "marko",
    "server"
  ],
  "homepage": "https://github.com/marko-js/language-server/tree/main/packages/volar-language-server/README.md",
  "bugs": "https://github.com/marko-js/language-server/issues/new?template=Bug_report.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/marko-js/language-server/tree/main/packages/volar-language-server"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "marko-language-server": "./bin.js"
  },
  "files": [
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && tsx build.mts",
    "test": "mocha './src/**/__tests__/*.test.ts'",
    "test:update": "mocha './src/**/__tests__/*.test.ts' --update"
  },
  "dependencies": {
    "@luxass/strip-json-comments": "^1.4.0",
    "@marko/compiler": "^5.39.29",
    "@marko/component-meta": "0.0.0",
    "@marko/language-tools": "^2.5.27",
    "@volar/kit": "^2.4.14",
    "@volar/language-core": "^2.4.14",
    "@volar/language-server": "^2.4.14",
    "@volar/language-service": "^2.4.14",
    "@volar/test-utils": "^2.4.14",
    "@volar/typescript": "^2.4.14",
    "axe-core": "^4.10.3",
    "htmljs-parser": "^5.6.1",
    "jsdom": "^26.1.0",
    "marko": "^5.37.41",
    "prettier": "^3.6.2",
    "prettier-plugin-marko": "^4.0.9",
    "relative-import-path": "^1.0.0",
    "typescript": "^6.0.3",
    "volar-service-css": "^0.0.64",
    "volar-service-emmet": "^0.0.64",
    "volar-service-html": "^0.0.64",
    "volar-service-prettier": "^0.0.64",
    "volar-service-typescript": "^0.0.64",
    "volar-service-typescript-twoslash-queries": "^0.0.64",
    "vscode-css-languageservice": "^6.3.7",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "tsx": "^4.20.3"
  }
